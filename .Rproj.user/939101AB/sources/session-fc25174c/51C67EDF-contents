# distribución general
ess3 %>% count(vote_drp, useNA = "always")

# cuántos casos eran "voto con no-match"
ess3 %>%
  summarise(
    n_vote = sum(!is.na(party_vote_chr)),
    n_match = sum(!is.na(is_drp)),
    n_nomatch = sum(!is.na(party_vote_chr) & is.na(is_drp))
  )

